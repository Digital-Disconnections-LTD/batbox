# Run with native UCRT64 CMake: cmake -P checks/indigenous_windows_dependencies.cmake
# This queries installed metadata only; no application configure or build occurs.
cmake_minimum_required(VERSION 3.24)
if(NOT CMAKE_HOST_WIN32)
  message(FATAL_ERROR "This probe requires native Windows CMake and an MSYS2 prefix")
endif()
set(MINGW TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/WindowsPkgConfig.cmake")
find_package(PkgConfig REQUIRED)
set(ENV{PKG_CONFIG_ALLOW_SYSTEM_CFLAGS} "1")
set(ENV{PKG_CONFIG_ALLOW_SYSTEM_LIBS} "1")
foreach(module libuv vips libpcre2-16 libwebsockets)
  pkg_check_modules(PROBE REQUIRED "${module}")
  foreach(directory IN LISTS PROBE_INCLUDE_DIRS PROBE_LIBRARY_DIRS)
    if(NOT IS_DIRECTORY "${directory}")
      message(FATAL_ERROR "${module} metadata names a missing directory: ${directory}")
    endif()
    if(directory MATCHES "^/(ucrt64|mingw64|mingw32|clang64|clangarm64)(/|$)")
      message(FATAL_ERROR "${module} retained an untranslated MSYS2 path: ${directory}")
    endif()
  endforeach()
  message(STATUS "${module}: include and library directories exist")
endforeach()
message(STATUS "Windows pkg-config sysroot: $ENV{PKG_CONFIG_SYSROOT_DIR}")
