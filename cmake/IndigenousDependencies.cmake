if(DEFINED ENV{BATBOX_ADA_SOURCE_DIR})
  set(batbox_ada_default "$ENV{BATBOX_ADA_SOURCE_DIR}")
else()
  set(batbox_ada_default "${CMAKE_BINARY_DIR}/indigenous-deps/ada-4.0.0")
endif()
set(BATBOX_ADA_SOURCE_DIR "${batbox_ada_default}" CACHE PATH "Pinned Ada URL indigenous source directory")
set(ADA_TESTING OFF CACHE BOOL "" FORCE)
set(ADA_BENCHMARKS OFF CACHE BOOL "" FORCE)
set(ADA_TOOLS OFF CACHE BOOL "" FORCE)
set(ADA_USE_SIMDUTF OFF CACHE BOOL "" FORCE)
set(ADA_INCLUDE_URL_PATTERN OFF CACHE BOOL "" FORCE)
if(EXISTS "${BATBOX_ADA_SOURCE_DIR}/include/ada.h")
  add_subdirectory("${BATBOX_ADA_SOURCE_DIR}" "${CMAKE_BINARY_DIR}/indigenous-deps/ada" EXCLUDE_FROM_ALL)
else()
  include(FetchContent)
  FetchContent_Declare(batbox_ada_sdk
    URL https://codeload.github.com/ada-url/ada/tar.gz/refs/tags/v4.0.0
    URL_HASH SHA256=6d6c7ef7dd2e329320d34eb2ab29ccdc879ee3935af9dfb894a6640e58dc381d
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_MakeAvailable(batbox_ada_sdk)
endif()
add_library(batbox_url src/runtime/Url.cpp)
target_link_libraries(batbox_url PUBLIC batbox_core PRIVATE ada::ada)
target_compile_options(batbox_url PRIVATE -Wall -Wextra -Wpedantic)
