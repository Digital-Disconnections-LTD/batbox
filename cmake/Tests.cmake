function(batbox_probe section library phase)
  set(target batbox-${section}-probe)
  add_executable(${target} tests/${phase}/${section}_probe.cpp)
  target_link_libraries(${target} PRIVATE ${library})

endfunction()
function(batbox_indigenous name source library)
  add_executable(batbox-${name} ${source})
  target_link_libraries(batbox-${name} PRIVATE ${library})
  add_test(NAME ${name} COMMAND batbox-${name})
endfunction()
