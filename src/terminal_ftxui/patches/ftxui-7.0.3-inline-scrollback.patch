+void App::Internal::CommitScrollback(std::string_view rows) {
+  if (dimension_ != AppDimension::TerminalOutput || rows.empty()) {
+    return;
+  }
+  if (frame_count_ != 0) {
+    TerminalSend(ResetCursorPosition());
+    public_->ResetPosition(output_buffer, /*clear=*/true);
+  }
+  TerminalSend(rows);
+  TerminalFlush();
+  public_->dimx_ = 0;
+  public_->dimy_ = 0;
+  frame_count_ = 0;
+  frame_valid_ = false;
+  set_cursor_position_.clear();
+  reset_cursor_position_.clear();
 }
 
