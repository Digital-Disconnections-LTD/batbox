# Preserve license bytes and intentional poetry whitespace.
third_party/notices/** -whitespace
third_party/licenses/** -whitespace
third_party/ftxui/LICENSE -whitespace
src/compaction/poetryEntries/*.cpp whitespace=-blank-at-eol
src/poetryEntries/Static*.cpp whitespace=-blank-at-eol
# The default system prompt is embedded byte for byte.
poetry/*.md text eol=lf
# Keep patches LF to match release archives; context includes one-space blank lines.
src/terminal_ftxui/patches/*.patch text eol=lf -whitespace
# `git archive` (GitHub release tarballs, Homebrew) writes the commit here.
cmake/ArchiveCommit.txt export-subst
